{
  "name": "pinyin-search-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/server.js",
    "dev:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./config/tailwind-input.css -o ./public/css/tailwind.css --watch",
    "dev": "concurrently \"npm run dev:css\" \"npm start\"",
    "build:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./config/tailwind-input.css -o ./public/css/tailwind.css --minify",
    "build": "npm run build:css",
    "lint": "eslint \"public/**/*.js\" -c ./config/eslint.config.js",
    "lint:fix": "eslint \"public/**/*.js\" --fix -c ./config/eslint.config.js",
    "test:parser": "node tests/parser-search-smoke.mjs",
    "stylelint": "stylelint \"config/tailwind-input.css\" --config ./config/.stylelintrc.json",
    "stylelint:fix": "stylelint \"config/tailwind-input.css\" --fix --config ./config/.stylelintrc.json"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "tailwindcss": "^4.2.2",
    "ws": "^8.20.0"
  },
  "browserslist": [
    "ios_saf >= 18",
    "not dead"
  ]
}
