{
  "name": "pinyin-search-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/server.js",
    "dev:css": "tailwindcss -c ./config/tailwind.config.js -i ./config/tailwind-input.css -o ./public/css/tailwind.css --content \"./public/index.html\" \"./public/js/**/*.js\" --watch",
    "dev": "concurrently \"npm run dev:css\" \"npm start\"",
    "build:css": "tailwindcss -c ./config/tailwind.config.js -i ./config/tailwind-input.css -o ./public/css/tailwind.css --minify --content \"./public/index.html\" \"./public/js/**/*.js\"",
    "build": "npm run build:css",
    "lint": "eslint \"public/**/*.js\" -c ./config/eslint.config.js",
    "lint:fix": "eslint \"public/**/*.js\" --fix -c ./config/eslint.config.js",
    "stylelint": "stylelint \"config/tailwind-input.css\" --config ./config/.stylelintrc.json",
    "stylelint:fix": "stylelint \"config/tailwind-input.css\" --fix --config ./config/.stylelintrc.json"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-no-unsupported-browser-features": "^8.0.5",
    "tailwindcss": "^3.4.18"
  },
  "browserslist": [
    "ios_saf >= 18",
    "not dead"
  ]
}
